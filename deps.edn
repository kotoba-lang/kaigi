{:paths ["src"]
 ;; kaigi is the meeting layer, not a second WebRTC implementation: track and
 ;; subscription state comes from `webrtc` (kotoba.webrtc.room/session) and
 ;; relay routing from `org-w3-webrtc-signaling` (kotoba.rt.core). Both are
 ;; pure .cljc with no transport, which is why they compose here without
 ;; dragging a runtime in.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/webrtc
        {:git/url "https://github.com/kotoba-lang/webrtc.git"
                                     :git/sha "55dfd79dbaf0199472815fc018f705e13d6a5452"}
        io.github.kotoba-lang/org-w3-webrtc-signaling
        {:git/url "https://github.com/kotoba-lang/org-w3-webrtc-signaling.git"
                                     :git/sha "ada557fd448b975a950d7d1a11efd9b2e3f6be2b"}
        ;; TURN: ephemeral credential mint/verify (and, for the relay-path
        ;; end-to-end test, a real UDP relay listener). kaigi does not
        ;; implement the coturn credential scheme itself.
        io.github.kotoba-lang/org-ietf-turn
        {:git/url "https://github.com/kotoba-lang/org-ietf-turn.git"
                                     :git/sha "ee7e1875433da8ed30313224a7a3b3edf3a3138f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}