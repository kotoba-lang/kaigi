{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaigi",
  "main": "dist/kaigi-worker.js",
  "compatibility_date": "2026-07-01",

  // The room is one Durable Object per meeting id. This is the binding
  // CLAUDE.md sanctions for DO use: a serializer and realtime room. Nothing
  // cross-meeting is stored in it — each DO's SQLite is private, so a
  // cross-meeting query plane placed there would split into one island per
  // room.
  "durable_objects": {
    "bindings": [
      { "name": "KAIGI_ROOMS", "class_name": "KaigiRoom" }
    ]
  },

  // SQLite-backed DO classes need an explicit migration tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KaigiRoom"] }
  ],

  // REALTIME_APP_ID / REALTIME_APP_TOKEN are deliberately ABSENT.
  //
  // No Cloudflare Realtime app has been provisioned for this account: the
  // wrangler OAuth session carries no `calls`/`realtime` scope, and creating
  // an app needs either the dashboard or an API token minted there. Until one
  // exists, `kaigi.plan/transport` reads the missing bindings as `:mesh` and
  // the deployment works for small meetings. Provisioning is one owner action
  // and no code change:
  //
  //   wrangler secret put REALTIME_APP_ID   --name kaigi
  //   wrangler secret put REALTIME_APP_TOKEN --name kaigi
  //
  // TURN_URL / TURN_USERNAME / TURN_CREDENTIAL are also absent, so
  // participants behind symmetric NAT will fail to connect over the mesh.
  // `kaigi.worker.room/ice-servers` reports the server list to the client as
  // data so the UI can say that, rather than spinning forever.
  "observability": { "enabled": true }
}
